function(ADD_EP_VERSION ep version)
    STRING(TOUPPER ext_${ep}_version name)
    SET(${name} ${version} PARENT_SCOPE)
    MESSAGE("-- External Project ${ep} version ... ${version}")
endfunction()

if (APPLE OR WIN32)
    ADD_EP_VERSION(libexiv2 v0.28.9)
    ADD_EP_VERSION(libjpeg-turbo 3.2.1)
    ADD_EP_VERSION(libraw 0.22.3)
    ADD_EP_VERSION(brotli v1.2.1)
    ADD_EP_VERSION(libjxl v0.12.0)
    ADD_EP_VERSION(highway 1.4.0)
endif()

if (WIN32)
    ADD_EP_VERSION(zlib v1.3.2)
    ADD_EP_VERSION(libexpat R_2_9_0)
    ADD_EP_VERSION(libde265 v1.1.3)
    ADD_EP_VERSION(libheif v1.23.7)
endif()
